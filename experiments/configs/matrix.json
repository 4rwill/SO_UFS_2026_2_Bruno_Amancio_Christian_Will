    {"id": "C3-workers1", "corpus": "small", "overrides": {"cache_capacity": 0, "workers": 1}},
    {"id": "C3-workers4", "corpus": "small", "overrides": {"cache_capacity": 0, "workers": 4}},
    {"id": "corpus-medium", "corpus": "medium", "overrides": {"cache_capacity": 0}},
    {"id": "corpus-large", "corpus": "large", "overrides": {"cache_capacity": 0}},
    {"id": "C4-cache1", "corpus": "small", "overrides": {"cache_capacity": 1}},
    {"id": "C4-cache3", "corpus": "small", "overrides": {"cache_capacity": 3}},
    {"id": "C5-context", "corpus": "large", "overrides": {"cache_capacity": 0, "top_k": 32, "context_bytes": 8192}},
    {"id": "C6-missing", "corpus": "small", "missing_index": true, "overrides": {"cache_capacity": 0}},
    {"id": "C6-recovery", "corpus": "small", "overrides": {"cache_capacity": 0}}
  ]
